# Desktop edition (cn or intl; defaults to intl)
MEMMY_APP_EDITION=intl

# Account backend (cuberouter | memmy_cloud). Defaults to cuberouter, which hides the
# memmy-cloud sign-up gift banner and the "no registration needed" bypass on the welcome
# page: a cuberouter identity cannot be granted the platform gift they advertise.
# Uncomment to restore them for a build that signs users in against memmy cloud.
# MEMMY_ACCOUNT_BACKEND=memmy_cloud

# Cloud service
MEMMY_CLOUD_SERVICE=https://memmy-api.memtensor.cn

# Analytics (GA4)
MEMMY_GA4_MEASUREMENT_ID=

# Legal agreement page base URLs
MEMMY_LEGAL_CN_BASE_URL=https://memmy.cn
MEMMY_LEGAL_INTL_BASE_URL=https://memmy.bot

# cuberouter（桌面端注册登录与模型供给）
# 单节点：设这个就够（设了它 = 钉死该地址、不出现线路选择）
MEMMY_CUBEROUTER_URL=http://127.0.0.1:3000
# 多节点：id=url 逗号分隔（id 是内部标识，只用来记住账号归属；换域名时 id 不变，用户无感）
# 注意优先级：MEMMY_CUBEROUTER_URL 一旦有值就是"钉死单节点"，NODES 会被忽略 ——
# 要开多节点，必须把上面那行 URL 注释掉。
# MEMMY_CUBEROUTER_NODES=cn=https://cuberouter.cn,hk=https://cuberouter.com
MEMMY_CUBEROUTER_MODEL=deepseek-flash
MEMMY_CUBEROUTER_TIMEOUT_MS=10000
# 组织：桌面端不自己建 token，而是从该组织里取一把预置的 key（由管理员创建）。
# 写全数字 = 直接当该实例的组织 id；写名字 = 每个节点各自解析成它自己的 id
#（两地部署给同一个组织分配的 id 通常不同，所以名字更通用）。
# 取不到时用户会看到「未取到组织 API Key，请联系管理员」。
MEMMY_CUBEROUTER_ORG=
# 那把 token 的名字，不设时用 memmy-desktop。
MEMMY_CUBEROUTER_ORG_TOKEN_NAME=
